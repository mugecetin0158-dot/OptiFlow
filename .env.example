# AI-first Smart Import needs a separately hosted private FastAPI server.
# The static Sites build has no server-side secret storage or API runtime.
# Set only the public server origin here; never put a key in NEXT_PUBLIC_*.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_* variables are public JavaScript, never secrets.
# Required for AI import on the private Python server only:
# GEMINI_API_KEY=...  (never commit a real value)
# GEMINI_IMPORT_MODEL defaults to gemini-2.5-flash; override only with an available model.
GEMINI_IMPORT_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2
# Required only to enable GET /diagnostics/gemini; generate a strong random secret.
# Keep this server-side on Render and send as Authorization: Bearer <token> only when diagnosing.
# GEMINI_DIAGNOSTIC_TOKEN=...
# Comma-separated browser origins allowed to call FastAPI.
OPTIFLOW_CORS_ORIGINS=http://localhost:3000
# The browser sends reduced metadata and redacted samples only after consent.
